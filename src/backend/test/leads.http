@baseUrl = http://localhost:3001

# ---------------------------------------------------------------------
# 1. ĐĂNG NHẬP CUSTOMER & SALES AGENT ĐỂ LẤY TOKEN
# ---------------------------------------------------------------------

### 1.1 Login Customer
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "phone": "0123456787",
  "password": "T@123456",
  "role": "CUSTOMER"
}

### Đặt Token Customer vào biến
@customerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjI0LCJwaG9uZSI6IjAxMjM0NTY3ODciLCJyb2xlIjoiQ1VTVE9NRVIiLCJpYXQiOjE3ODUwNzIzMTYsImV4cCI6MTc4NTY3NzExNn0.9YYbzxmac5CoHD3S8wnelWMlK24tDtluKZmhNip-dz8


