# ---------------------------------------------------------------------
# 2. USE CASE 10: REQUEST FOR CONSULTATION (CUSTOMER)
# ---------------------------------------------------------------------

### 2.1 Customer tạo yêu cầu tư vấn mới (Thay propertyId bằng ID thực tế trong DB)
# @name createLead
POST {{baseUrl}}/leads
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjI0LCJwaG9uZSI6IjAxMjM0NTY3ODciLCJyb2xlIjoiQ1VTVE9NRVIiLCJpYXQiOjE3ODUwNzIzMTYsImV4cCI6MTc4NTY3NzExNn0.9YYbzxmac5CoHD3S8wnelWMlK24tDtluKZmhNip-dz8
Content-Type: application/json

{
  "propertyId": 1,
  "note": "Tôi muốn tư vấn thêm về căn hộ này."
}

### Đặt ID Lead vừa tạo vào biến
@leadId = 1


### 2.2 Test Duplicate Check (Gửi lại request khi đang PENDING/NEW) -> Mong đợi: 400 Bad Request
POST {{baseUrl}}/leads
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjI0LCJwaG9uZSI6IjAxMjM0NTY3ODciLCJyb2xlIjoiQ1VTVE9NRVIiLCJpYXQiOjE3ODUwNzIzMTYsImV4cCI6MTc4NTY3NzExNn0.9YYbzxmac5CoHD3S8wnelWMlK24tDtluKZmhNip-dz8
Content-Type: application/json

{
  "propertyId": 1,
  "note": "Gửi trùng lặp để kiểm tra validation",
  "reginonId": 1
}


